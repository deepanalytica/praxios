{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praxios.local/schemas/session-harvest.schema.json",
  "title": "PRAXIOS Session Harvest",
  "type": "object",
  "required": ["schemaVersion","sessionId","source","title","createdAt","summary","items"],
  "properties": {
    "schemaVersion": {"const":"1.0"},
    "sessionId": {"type":"string","minLength":3},
    "source": {"enum":["chatgpt","claude","claude-code","codex","gemini","human","other"]},
    "title": {"type":"string","minLength":1},
    "project": {"type":"string"},
    "createdAt": {"type":"string","format":"date-time"},
    "summary": {"type":"string","minLength":1},
    "raw": {"type":"string"},
    "items": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["kind","title"],
        "properties":{
          "kind":{"enum":["idea","decision","task","risk","opportunity","evidence","goal","resource","finding"]},
          "title":{"type":"string","minLength":1},
          "summary":{"type":"string"},
          "project":{"type":"string"},
          "confidence":{"type":"number","minimum":0,"maximum":100},
          "severity":{"enum":["low","medium","high","critical"]},
          "tags":{"type":"array","items":{"type":"string"}},
          "relatesTo":{"type":"array","items":{"type":"string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
